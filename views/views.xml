<odoo>
  <data>
    <record id="view_form_sale_inherit_usd" model="ir.ui.view">
      <field name="name">sale_inherit_usd</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="x_studio_ok_para_la_entrega" invisible="1"/>
      <field name="arch" type="xml">

	<!-- 1. Insertamos el campo x_sale_dolares y x_tipo_cambio -->
	<xpath expr="//group[@name='order_details']" position="inside">
	  <field name="x_sale_dolares"/>
	  <field name="x_tipo_cambio" invisible="x_sale_dolares !=True"/>
	</xpath>

	<!-- 2. Extendemos el contexto del campo order_line -->
	<xpath expr="//field[@name='order_line']" position="attributes">
	  <attribute name="context">
            {
	    'partner_id': partner_id,
	    'pricelist': pricelist_id,
	    'company_id': company_id,
	    'mostrar_usd': x_sale_dolares
	    }
	  </attribute>
	</xpath>

	<!-- 3. Agregamos el campo x_sale_pcio_usd antes del precio unitario -->
	<xpath expr="//tree/field[@name='price_unit']" position="before">
	  <!-- <field name="x_sale_pcio_usd" column_invisible="not mostrar_usd"/> - -->
	  <field name="x_sale_pcio_usd" invisible="context.get('mostrar_usd') != True"/>
	</xpath>

      </field>

    </record>

