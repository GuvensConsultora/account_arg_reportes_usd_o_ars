<odoo>
  <template id="report_invoice_document_inherit_usd" inherit_id="l10n_ar.report_invoice_document">
    <!-- Precio unitario en USD si se activa el tilde -->
    <xpath expr="//span[@t-out=&quot;l10n_ar_values['price_unit']&quot;]" position="replace">
      <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
	<span t-esc="round(l10n_ar_values['price_unit'] / o.x_tipo_cambio, 2)"/>
      </t>  
      <t t-else="">
        <span t-out="l10n_ar_values['price_unit']"/>
      </t>
    </xpath>
    <xpath expr="//span[@t-out=&quot;l10n_ar_values['price_subtotal']&quot;]" position="replace">
      <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
        <span t-esc="round(l10n_ar_values['price_subtotal'] / o.x_tipo_cambio, 2)"/>
      </t>
      <t t-else="">
        <span t-out="l10n_ar_values['price_subtotal']"/>
      </t>
    </xpath>
    <div>
      <t t-if="document_letter == 'B'">
	<!--<strong>Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)</strong>
	    <t t-foreach="o.tax_totals['groups_by_subtotal']['Subtotal']" t-as="subtotal_key">
	      <span t-esc="subtotal_key['tax_group_name']"/>
	      <span t-esc="subtotal_key['tax_group_amount']"/>
	    </t>-->
	    <table class="border border-2 border-secondary rounded shadow-sm overflow-hidden">
	      <tbody>
		<tr>
		  <td><strong>Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)</strong></td>
		  <td>Impuestos</td>
		  <td>
		    <table class="table table-sm table-striped table-borderless align-middle">
		      <t t-foreach="o.tax_totals['groups_by_subtotal']['Subtotal']" t-as="subtotal_key">
			<tr><td>
			    <span t-esc="subtotal_key['tax_group_name']"/>:
			  </td><td class="text-end" >
			    <span t-esc="subtotal_key['tax_group_amount']"/>
			</td></tr>
		      </t>
		    </table>
		  </td>
		</tr>
	      </tbody>
	    </table>
      </t>
    </div>
  </template>
  <template inherit_id="account.document_tax_totals" id="document_tax_totals_usd" >
    <!-- Cambiar nombre del template si hace falta reusar -->
    <xpath expr="." position="attributes">
      <attribute name="t-name">l10n_ar.document_tax_totals</attribute>
    </xpath>
    <!-- Mostrar subtotales en USD -->
    <xpath expr="//tr[@class='border-black o_subtotal']/td[@class='text-end']" position="replace">
      <td class="text-end">
        <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
          <span t-esc="round(subtotal['amount'] / o.x_tipo_cambio, 2)"/>
        </t>
        <t t-else="">
          <span t-out="subtotal['formatted_amount']"/>
        </t>
      </td>
    </xpath>

    <xpath expr="//t[@t-call='account.tax_groups_totals']" position="replace">
      <t t-call="account.tax_groups_totals"/>
    </xpath>

    <!-- Mostrar total con redondeo en USD -->
    <xpath expr="//tr[@class='border-black o_total']/td[@class='text-end']" position="replace">
      <td class="text-end">
        <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
          <span t-esc="round(tax_totals['amount_total'] / o.x_tipo_cambio, 2)"/>
        </t>
        <t t-else="">
          <span t-out="tax_totals.get('formatted_amount_total')"/>
        </t>
      </td>
    </xpath>
  </template>  
</odoo>
