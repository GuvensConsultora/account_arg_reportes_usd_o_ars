<odoo>
  <!--
    Template: Override de tax totals para mostrar USD
    Por qué: Odoo 19 eliminó account.tax_groups_totals.
    Ahora tax_totals usa subtotals[].tax_groups[] y el template
    base es account.document_tax_totals_template.
    Heredamos de account.document_tax_totals (primary inherit vacío).
    Patrón: lookup por group_name para obtener importes precalculados.
  -->
  <template id="document_tax_totals_usd"
            inherit_id="account.document_tax_totals">
    <xpath expr="." position="replace">
      <!-- Preparar lookup de impuestos USD por nombre -->
      <t t-if="o.x_factura_dolares and o.x_usd_display_data">
        <t t-set="usd_taxes_map"
           t-value="{tx['name']: tx for tx in o.x_usd_display_data.get('taxes', [])}"/>
      </t>

      <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']"/>
      <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
        <!-- Fila subtotal (ej: "Importe sin impuestos") -->
        <tr t-if="subtotal['tax_groups']" class="o_subtotal">
          <td><span t-out="subtotal['name']"/></td>
          <td class="text-end">
            <t t-if="o.x_factura_dolares and o.x_usd_display_data">
              <span t-esc="'%.2f' % o.x_usd_display_data.get('subtotal_usd', 0)"/>
            </t>
            <t t-else="">
              <span t-out="subtotal['base_amount_currency']"
                    t-options='{"widget": "monetary", "display_currency": currency}'/>
            </t>
          </td>
        </tr>

        <!-- Filas de grupos impositivos -->
        <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
          <tr class="o_taxes">
            <t t-if="same_tax_base or tax_group['display_base_amount_currency'] is False">
              <!-- Simple: nombre + importe -->
              <td><span t-out="tax_group['group_name']"/></td>
              <td class="text-end o_price_total">
                <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                  <t t-set="tax_usd"
                     t-value="usd_taxes_map.get(tax_group['group_name'], {})"/>
                  <span t-esc="'%.2f' % tax_usd.get('amount_usd', 0)"/>
                </t>
                <t t-else="">
                  <span t-out="tax_group['tax_amount_currency']"
                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                </t>
              </td>
            </t>
            <t t-else="">
              <!-- Detallado: nombre + base + importe -->
              <td>
                <span t-out="tax_group['group_name']"/>
                <span> sobre </span>
                <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                  <t t-set="tax_usd"
                     t-value="usd_taxes_map.get(tax_group['group_name'], {})"/>
                  <span t-esc="'%.2f' % tax_usd.get('base_usd', 0)"/>
                </t>
                <t t-else="">
                  <span t-out="tax_group['display_base_amount_currency']"
                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                </t>
              </td>
              <td class="text-end o_price_total">
                <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                  <t t-set="tax_usd"
                     t-value="usd_taxes_map.get(tax_group['group_name'], {})"/>
                  <span t-esc="'%.2f' % tax_usd.get('amount_usd', 0)"/>
                </t>
                <t t-else="">
                  <span t-out="tax_group['tax_amount_currency']"
                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                </t>
              </td>
            </t>
          </tr>
        </t>
      </t>

      <!-- Cash rounding -->
      <tr t-if="'cash_rounding_base_amount_currency' in tax_totals">
        <td>Redondeo</td>
        <td class="text-end">
          <span t-out="tax_totals['cash_rounding_base_amount_currency']"
                t-options='{"widget": "monetary", "display_currency": currency}'/>
        </td>
      </tr>

      <!-- Total -->
      <tr class="o_total">
        <td><strong>Total</strong></td>
        <td class="text-end">
          <t t-if="o.x_factura_dolares and o.x_usd_display_data">
            <strong t-esc="'%.2f' % o.x_usd_display_data.get('total_usd', 0)"/>
          </t>
          <t t-else="">
            <strong t-out="tax_totals['total_amount_currency']"
                    t-options='{"widget": "monetary", "display_currency": currency}'/>
          </t>
        </td>
      </tr>
    </xpath>
  </template>
</odoo>
