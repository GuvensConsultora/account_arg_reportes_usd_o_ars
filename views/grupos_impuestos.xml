<odoo>
  <!--
    Template: Grupos de impuestos con conversión USD
    Por qué: lee importes del dict precalculado (x_usd_display_data)
    para que base + impuesto + total cuadren exacto.
    Patrón: lookup por nombre de grupo impositivo.
  -->
  <template id="grupos_de_impuesto_en_facturas"
            inherit_id="account.tax_groups_totals">
    <xpath expr="." position="replace">
      <!-- Preparar lookup de impuestos USD por nombre -->
      <t t-if="o.x_factura_dolares and o.x_usd_display_data">
        <t t-set="usd_taxes_map"
           t-value="{tx['name']: tx for tx in o.x_usd_display_data.get('taxes', [])}"/>
      </t>

      <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]"
         t-as="amount_by_group">
        <t t-set="display_tax_base" t-value="tax_totals['display_tax_base']"/>
        <tr>
          <t t-if="tax_totals['display_tax_base']">
            <td>
              <span t-esc="amount_by_group['tax_group_name']"/>
              <span t-if="not amount_by_group['hide_base_amount']"
                    class="text-nowrap">
                <!-- Base imponible: precalculada o formateada -->
                <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                  <t t-set="tax_usd"
                     t-value="usd_taxes_map.get(amount_by_group['tax_group_name'], {})"/>
                  /<span t-esc="'%.2f' % tax_usd.get('base_usd', 0)"/>
                </t>
                <t t-else="">
                  /<t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                </t>
              </span>
            </td>
            <td class="text-end o_price_total">
              <!-- Importe impuesto: precalculado o formateado -->
              <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                <t t-set="tax_usd"
                   t-value="usd_taxes_map.get(amount_by_group['tax_group_name'], {})"/>
                <span t-esc="'%.2f' % tax_usd.get('amount_usd', 0)"/>
              </t>
              <t t-else="">
                <span class="text-nowrap"
                      t-out="amount_by_group['formatted_tax_group_amount']"/>
              </t>
            </td>
          </t>
          <t t-else="">
            <td>
              <span t-out="amount_by_group['tax_group_name']"/>
            </td>
            <td class="text-end o_price_total">
              <t t-if="o.x_factura_dolares and o.x_usd_display_data">
                <t t-set="tax_usd"
                   t-value="usd_taxes_map.get(amount_by_group['tax_group_name'], {})"/>
                <span t-esc="'%.2f' % tax_usd.get('amount_usd', 0)"/>
              </t>
              <t t-else="">
                <span class="text-nowrap"
                      t-out="amount_by_group['formatted_tax_group_amount']"/>
              </t>
            </td>
          </t>
        </tr>
      </t>
    </xpath>
  </template>
</odoo>
