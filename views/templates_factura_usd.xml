<odoo>
  <!--
    Template: Conversión USD en líneas de factura argentina
    Por qué: Los importes se precalculan en Python (x_usd_display_data)
    para evitar errores de redondeo al dividir cada línea por separado.
    Patrón: Single Source of Truth — el total se convierte UNA sola vez
    y la diferencia se ajusta en la última línea.
  -->
  <template id="report_invoice_document_inherit_usd"
            inherit_id="l10n_ar.report_invoice_document">

    <!-- Cargar datos USD precalculados al inicio del documento -->
    <xpath expr="//div[@id='informations']" position="before">
      <t t-if="o.x_factura_dolares and o.x_usd_display_data">
        <!-- Tip: dict {line_id: line_data} para lookup O(1) en vez de iterar -->
        <t t-set="usd_lines_map"
           t-value="{str(l['line_id']): l for l in o.x_usd_display_data.get('lines', [])}"/>
      </t>
    </xpath>

    <!-- Precio unitario en USD -->
    <xpath expr="//span[@t-out=&quot;l10n_ar_values['price_unit']&quot;]" position="replace">
      <t t-if="o.x_factura_dolares and o.x_usd_display_data">
        <t t-set="line_usd" t-value="usd_lines_map.get(str(line.id), {})"/>
        <span t-esc="'%.2f' % line_usd.get('price_unit_usd', 0)"/>
      </t>
      <t t-else="">
        <span t-out="l10n_ar_values['price_unit']"/>
      </t>
    </xpath>

    <!-- Subtotal de línea en USD -->
    <xpath expr="//span[@t-out=&quot;l10n_ar_values['price_subtotal']&quot;]" position="replace">
      <t t-if="o.x_factura_dolares and o.x_usd_display_data">
        <t t-set="line_usd" t-value="usd_lines_map.get(str(line.id), {})"/>
        <span t-esc="'%.2f' % line_usd.get('price_subtotal_usd', 0)"/>
      </t>
      <t t-else="">
        <span t-out="l10n_ar_values['price_subtotal']"/>
      </t>
    </xpath>

    <!-- Cuadro Transparencia Fiscal (Factura B) -->
    <!-- Odoo 19: tax_totals usa subtotals[].tax_groups[] -->
    <div>
      <t t-if="document_letter == 'B'">
        <table class="border border-2 border-secondary rounded shadow-sm overflow-hidden">
          <tbody>
            <tr>
              <td><strong>Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)</strong></td>
              <td>Impuestos</td>
              <td>
                <table class="table table-sm table-striped table-borderless align-middle">
                  <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="st">
                    <t t-foreach="st.get('tax_groups', [])" t-as="tg">
                      <tr>
                        <td><span t-esc="tg['group_name']"/>:</td>
                        <td class="text-end">
                          <span t-out="tg['tax_amount_currency']"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                      </tr>
                    </t>
                  </t>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </t>
    </div>
  </template>

  <!--
    Mejoras visuales al documento de factura estándar l10n_ar.
    Por qué: Reemplaza la sección #informations completa para mejorar legibilidad.
    Patrón: position="replace" sobre div#informations, recrea ambas columnas con
    mejor line-height, spacing entre campos, y etiquetas destacadas.
  -->
  <template id="l10n_ar_visual_improvements" inherit_id="l10n_ar.report_invoice_document">

    <!-- Reemplazar bloque informations completo para mejor legibilidad -->
    <xpath expr="//div[@id='informations']" position="replace">
      <div id="informations" class="row mt-3 mb-3" style="font-size: 13px;">

        <!-- Columna izquierda: datos del cliente -->
        <div class="col-6" style="border: 1px solid #adb5bd; border-radius: 4px; padding: 12px; line-height: 2.0;">

          <t t-if="o.is_sale_document(include_receipts=True)">
            <span style="font-size: 14px; font-weight: bold;">Cliente: </span>
          </t>
          <t t-else="">
            <span style="font-size: 14px; font-weight: bold;">Proveedor: </span>
          </t>
          <span t-field="o.partner_id.commercial_partner_id.name" style="font-size: 14px; font-weight: bold;"/>
          <br/>

          <span t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': true, 'no_tag_br': True}"/>
          <br/>

          <strong>Cond. IVA: </strong>
          <span t-field="o.partner_id.l10n_ar_afip_responsibility_type_id"/>

          <t t-if="o.partner_id.vat and o.partner_id.l10n_latam_identification_type_id and o.partner_id.l10n_latam_identification_type_id.l10n_ar_afip_code != '99'">
            <br/>
            <strong><t t-out="o.partner_id.l10n_latam_identification_type_id.name or o.company_id.account_fiscal_country_id.vat_label"/>: </strong>
            <span t-out="o.partner_id.l10n_ar_formatted_vat if o.partner_id.l10n_ar_vat else o.partner_id.vat" style="font-weight: bold;"/>
          </t>
        </div>

        <!-- Columna derecha: datos de la factura -->
        <div class="col-6" style="border: 1px solid #adb5bd; border-radius: 4px; padding: 12px; line-height: 2.0;">

          <t t-if="o.invoice_date_due">
            <strong>Fecha Vencimiento: </strong>
            <span t-field="o.invoice_date_due" style="font-weight: bold;"/>
            <br/>
          </t>

          <t t-if="o.invoice_payment_term_id" name="payment_term">
            <strong>Plazos de Pago: </strong>
            <span t-field="o.invoice_payment_term_id.name"/>
            <br/>
          </t>

          <t t-if="o.invoice_origin">
            <strong>Origen: </strong>
            <span t-field="o.invoice_origin"/>
            <br/>
          </t>

          <t t-if="o.ref">
            <strong>Referencia: </strong>
            <span t-field="o.ref"/>
            <br/>
          </t>

          <t t-if="o.invoice_incoterm_id">
            <strong>Incoterm: </strong>
            <span t-field="o.invoice_incoterm_id.code"/>
            <t t-if="o.incoterm_location">
              - <span t-field="o.incoterm_location"/>
            </t>
          </t>
        </div>

      </div>
    </xpath>

    <!-- Fondo gris claro en header de tabla de líneas -->
    <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="attributes">
      <attribute name="style">background-color: #f8f9fa;</attribute>
    </xpath>

    <!-- Separador visual antes de totales -->
    <xpath expr="//div[@id='total']" position="attributes">
      <attribute name="style">border-top: 2px solid #000; padding-top: 10px;</attribute>
    </xpath>

  </template>

  <!--
    Mover "Impuestos AR" a la izquierda del cuadro de totales.
    Por qué: Ambos cuadros quedan a la misma altura en la misma fila.
    Patrón: Convertir right-elements en flex container con ambos cuadros lado a lado.
  -->
  <template id="l10n_ar_impuestos_ar_left" inherit_id="l10n_ar.report_invoice_document">

    <!-- 1. Ampliar right-elements a ancho completo con flexbox -->
    <xpath expr="//div[@id='right-elements']" position="attributes">
      <attribute name="class">col-12 float-end d-flex justify-content-end align-items-start gap-4</attribute>
    </xpath>

    <!-- 2. Insertar cuadro Impuestos AR ANTES de div#total (queda a la izquierda) -->
    <xpath expr="//div[@id='total']" position="before">
      <t t-if="o.tax_totals and o.tax_totals.get('display_in_company_currency')">
        <t t-set="tax_totals" t-value="o.tax_totals"/>
        <!-- Safety net: asegurar keys Enterprise en dict Community -->
        <t t-foreach="tax_totals.get('subtotals', [])" t-as="_sub">
          <t t-set="_" t-value="_sub.setdefault('amount_company_currency', _sub.get('base_amount', 0))"/>
          <t t-foreach="_sub.get('tax_groups', [])" t-as="_tg">
            <t t-set="_" t-value="_tg.setdefault('tax_amount_company_currency', _tg.get('tax_amount', 0))"/>
            <t t-set="_" t-value="_tg.setdefault('display_base_amount_company_currency', _tg.get('display_base_amount', False))"/>
          </t>
        </t>
        <t t-set="_" t-value="tax_totals.setdefault('total_amount_company_currency', tax_totals.get('total_amount', 0))"/>
        <div class="flex-shrink-0" style="min-width: 45%;">
          <t t-call="account.document_tax_totals_company_currency_template"/>
        </div>
      </t>
    </xpath>

    <!--
      3. Ocultar Impuestos AR original (está dentro de div#right-elements, fuera de div#total).
      Por qué: Reemplazar el t-call directamente es más robusto que intentar matchear
      el t-if padre con comillas escapadas que pueden variar entre versiones.
    -->
    <xpath expr="//div[@id='right-elements']//t[@t-call='account.document_tax_totals_company_currency_template']"
           position="replace"/>


  </template>

  <!--
    Vendedor en encabezado derecho.
    Por qué: div#l10n_ar_header_right está en l10n_ar.custom_header, NO en report_invoice_document.
    Hay que heredar del template correcto.
  -->
  <template id="l10n_ar_header_vendedor" inherit_id="l10n_ar.custom_header">
    <xpath expr="//div[@id='l10n_ar_header_right']" position="inside">
      <t t-if="o.invoice_user_id">
        <br/>
        <span t-att-style="'color: %s;' % o.company_id.secondary_color">Vendedor: </span>
        <span t-field="o.invoice_user_id.name"/>
      </t>
    </xpath>
  </template>

  <!--
    Cambios pedidos por Facu al contenido de factura:
    1. Ocultar Plazos de Pago del bloque informations
    2. Agregar zona "Forma de pago" / "Anticipo" / "Forma de pago convenida" a la izquierda de totales
  -->
  <template id="l10n_ar_facu_changes" inherit_id="l10n_ar.report_invoice_document">

    <!-- 1. Ocultar "Payment Terms" del encabezado -->
    <xpath expr="//div[@id='informations']//t[@name='payment_term']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>

    <!-- 2. Zona "Forma de pago" a la izquierda de los totales -->
    <xpath expr="//div[@id='right-elements']" position="before">
      <div class="d-inline-block float-start" style="width: 50%; font-size: 10px;">
        <!-- Forma de pago: muestra el plazo de pago asignado -->
        <t t-if="o.invoice_payment_term_id">
          <div style="margin-bottom: 4px;">
            <strong>Forma de pago: </strong>
            <span t-field="o.invoice_payment_term_id.name"/>
          </div>
        </t>
        <!-- Anticipo: monto adelantado si está cargado -->
        <t t-if="o.x_anticipo">
          <div style="margin-bottom: 4px;">
            <strong>Anticipo: </strong>
            <span t-field="o.x_anticipo"
                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
          </div>
        </t>
        <!-- Forma de pago convenida: texto libre del acuerdo -->
        <t t-if="o.x_forma_pago_convenida">
          <div style="margin-bottom: 4px;">
            <strong>Forma de pago convenida: </strong>
            <span t-field="o.x_forma_pago_convenida"/>
          </div>
        </t>
      </div>
    </xpath>

  </template>

</odoo>
