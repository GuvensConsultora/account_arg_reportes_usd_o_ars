<odoo>
    <template id="report_invoice_document_inherit_usd" inherit_id="l10n_ar.report_invoice_document">

        <!-- Definir tipo de cambio
	<xpath expr="//t[@t-call='l10n_ar.document_tax_totals']" position="before">
          <t t-set="tc" t-value="o.x_tipo_cambio or 1.0"/>
	  <strong t-esc="tc" />
	  <strong t-esc="o.x_factura_dolares"/>
        </xpath> -->

        <!-- Precio unitario en USD si se activa el tilde -->
        <xpath expr="//span[@t-out=&quot;l10n_ar_values['price_unit']&quot;]" position="replace">
	  <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
	    <span t-esc="round(l10n_ar_values['price_unit'] / o.x_tipo_cambio, 2)"/> USD
	  </t>  
	    <t t-else="">
                <span t-out="l10n_ar_values['price_unit']"/>
            </t>
        </xpath>
	<xpath expr="//span[@t-out=&quot;l10n_ar_values['price_subtotal']&quot;]" position="replace">
	  <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
            <span t-esc="round(l10n_ar_values['price_subtotal'] / o.x_tipo_cambio, 2)"/> USD
	  </t>
	  <t t-else="">
            <span t-out="l10n_ar_values['price_subtotal']"/>
	  </t>
	</xpath>
    </template>
    <template id="document_tax_totals_inherit_usd" inherit_id="account.document_tax_totals">
      <!-- Subtotal en USD --> 
      <xpath expr="//tr[@class='border-black o_subtotal']/td[@class='text-end']" position="replace">
        <td class="text-end">
          <t t-if="o.x_factura_dolares and o.x_tipo_cambio">
	    <span t-esc="round(o.amount_untaxed / o.x_tipo_cambio, 2)"/> USD
          </t>
          <t t-else="">
            <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
          </t>
        </td>
      </xpath>

      <!-- Impuestos en USD  
